# Copy to .env.local (git-ignored). Never put secrets in this file.

# League
ESPN_LEAGUE_ID=
ESPN_SEASON=2027

# ESPN cookies live outside the repo in a file containing ESPN_S2=... and ESPN_SWID=...
ESPN_COOKIES_FILE=~/.config/hoops-dream/espn.env

# Local API
DATA_DIR=./data
LISTEN_ADDR=127.0.0.1
PORT=8080
CORS_ORIGINS=http://localhost:5173

# Identity provider (same values fro local and prod; no secrets needed by API)
AUTH_ISSUER=https://<tenant>.<region>.auth0.com/
AUTH_AUDIENCE=https://api.hoops-dream

# Frontend (Vite reads VITE_* at build time)
VITE_API_URL=http://localhost:8080
VITE_AUTH_DOMAIN=<tenant>.<region>.auth0.com
VITE_AUTH_CLIENT_ID=
VITE_AUTH_AUDIENCE=https://api.hoops-dream